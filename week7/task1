class ParkingSystem {
    private int[] count;

    public ParkingSystem(int big, int medium, int small) {
        // Map car types 1, 2, and 3 to 1-based indexing for convenience
        count = new int[]{0, big, medium, small};
    }
    
    public boolean addCar(int carType) {
        if (count[carType] > 0) {
            count[carType]--;
            return true;
        }
        return false;
    }
}

