class Solution {
    public int maxSubarraySumCircular(int[] nums) {
        int totalSum = 0;
        int maxSoFar = nums[0];
        int currentMax = 0;
        int minSoFar = nums[0];
        int currentMin = 0;

        for (int num : nums) {
            totalSum += num;

            // Standard Kadane's algorithm to find maximum subarray sum
            currentMax = Math.max(num, currentMax + num);
            maxSoFar = Math.max(maxSoFar, currentMax);

            // Modified Kadane's algorithm to find minimum subarray sum
            currentMin = Math.min(num, currentMin + num);
            minSoFar = Math.min(minSoFar, currentMin);
        }

        // If all elements are negative, totalSum - minSoFar equals 0 (empty set),
        // so we must return maxSoFar.
        if (maxSoFar < 0) {
            return maxSoFar;
        }

        return Math.max(maxSoFar, totalSum - minSoFar);
    }
}

